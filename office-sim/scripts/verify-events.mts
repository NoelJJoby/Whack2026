// Browser acceptance through the real manager/engine, with deterministic AI fixtures and local storage.
import assert from 'node:assert/strict';
import { mkdirSync, mkdtempSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { createStubProvider } from '../server/stub-provider';
process.env.SIM_STORE_DIR = mkdtempSync(join(tmpdir(),'events-browser-singleton-'));
const { OfficeSimManager } = await import('../server/index');
const { chromium } = await import(process.env.PLAYWRIGHT_MODULE ?? 'playwright');
const artifacts = process.env.UI_ARTIFACT_DIR ?? join(tmpdir(),'events-ui'); mkdirSync(artifacts,{recursive:true});
const m = new OfficeSimManager(mkdtempSync(join(tmpdir(),'events-browser-')),{provider:createStubProvider(42),reportProvider:async () => null});
m.reseed(42); m.settings({max_ticks:45});
m.injectBusiness({template_id:'client_win'});
for (let i = 0; i < 14; i++) await m.step();
m.injectBusiness({template_id:'material_breach'});
for (let i = 0; i < 14; i++) await m.step();
m.injectBusiness({template_id:'cost_review'});
while (m.response().state.tick < 45) await m.step();
const run = m.response().run_id!; await m.reporting.generate(run);
const report = m.store.reports(run).at(-1)!;
const browser = await chromium.launch({headless:true,executablePath:process.env.CHROMIUM_EXECUTABLE});
const page = await browser.newPage(); const errors: string[] = [];
page.on('pageerror',e => errors.push(e.message));
await page.addInitScript(`window.EventSource=class{onmessage=null;onerror=null;constructor(){window.__stream=this;}close(){}};`);
await page.route('**/api/**',async route => {
  const url = new URL(route.request().url()); const path = url.pathname;
  let json: unknown;
  if (path === '/api/sim/cast') json = m.castResponse();
  else if (path === '/api/sim/history') json = m.history();
  else if (path === '/api/runs') json = m.store.list();
  else if (/\/api\/runs\/[^/]+$/.test(path)) {
    const id = path.split('/').at(-1)!; const txs = m.store.read(id); const cutoff = Number(url.searchParams.get('cutoff') ?? txs.length);
    json = {metadata:m.store.metadata(id),world:txs[cutoff-1].world,reports:m.store.reports(id),pending:false};
  } else if (path.endsWith('/report') && route.request().method() === 'POST') json = await m.reporting.generate(path.split('/')[3],true);
  else if (path.includes('/reports/')) json = m.store.reports(path.split('/')[3]).find(r => r.id === path.split('/')[5]);
  else json = m.response();
  await route.fulfill({json});
});
await page.goto(process.env.UI_URL ?? 'http://127.0.0.1:5178/');
await page.waitForFunction(() => (window as any).__stream?.onmessage);
await page.evaluate(data => (window as any).__stream.onmessage({data:JSON.stringify(data)}),{type:'history',...m.history()});
await page.waitForSelector('[data-employee]');
for (const [width,height] of [[1440,900],[1280,720],[640,800]]) {
  await page.setViewportSize({width,height});
  await page.getByRole('button',{name:'Business events',exact:true}).click();
  const dialog = page.getByRole('dialog',{name:'Business events',exact:true});
  await dialog.getByLabel('Include completed cases').check();
  const client = dialog.locator('.case-card').filter({hasText:'qualified client'}).first(); await client.click();
  await dialog.getByText('Contract signed:',{exact:false}).waitFor();
  assert.ok((await dialog.locator('.event-story').innerText()).includes('Frozen target: £1,000,000'));
  assert.ok((await dialog.locator('.event-story').innerText()).includes('CEO decision'));
  assert.ok((await dialog.locator('.event-story').innerText()).includes('Ops assignments'));
  await page.screenshot({path:join(artifacts,`client-${width}.png`)});
  await dialog.locator('.case-card').filter({hasText:'supplier confirms'}).first().click();
  assert.ok((await dialog.locator('.event-story').innerText()).includes('Contained'));
  await page.screenshot({path:join(artifacts,`breach-${width}.png`)});
  await dialog.locator('.case-card').filter({hasText:'operating-budget'}).first().click();
  assert.ok((await dialog.locator('.event-story').innerText()).includes('layoffs avoided'));
  const content = dialog.locator('.tool-content');
  assert.ok(await content.evaluate(el => el.scrollWidth <= el.clientWidth));
  const box = await dialog.boundingBox(); assert.ok(box && box.x >= 0 && box.y >= 0 && box.x+box.width <= width && box.y+box.height <= height);
  await dialog.getByRole('heading',{name:'Business report and archives'}).scrollIntoViewIfNeeded();
  await dialog.getByText('AI analysis unavailable.',{exact:false}).waitFor();
  assert.equal(await dialog.getByRole('link',{name:'Download Markdown'}).count(),1);
  assert.equal(await dialog.getByRole('link',{name:'Download JSON evidence'}).count(),1);
  await dialog.getByRole('button',{name:'Source: run-metrics',exact:true}).first().click();
  await dialog.getByRole('heading',{name:'Source evidence'}).waitFor();
  await page.screenshot({path:join(artifacts,`report-${width}.png`)});
  await page.keyboard.press('Escape');
  assert.equal(await page.getByRole('button',{name:'Business events',exact:true}).evaluate(el => el === document.activeElement),true);
}
// Reconnection rebuilds cases without replaying historical banners; reset preserves the archive.
assert.equal(await page.locator('.announcement').count(),0);
m.reset();
await page.evaluate(data => (window as any).__stream.onmessage({data:JSON.stringify(data)}),{type:'history',...m.history()});
await page.getByRole('button',{name:'Business events',exact:true}).click();
await page.getByRole('combobox',{name:'Run',exact:true}).selectOption(run);
await page.getByText('AI analysis unavailable.',{exact:false}).waitFor();
assert.equal(m.store.reports(run)[0].id,report.id);
assert.deepEqual(errors,[]);
await browser.close();
console.log(JSON.stringify({verified:['client win','breach','layoffs avoided','report citations','archived report after reset','keyboard focus','small window','history reconnect'],artifacts,run,report:report.id}));
